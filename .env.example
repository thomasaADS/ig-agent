# ---- Server ----
# Domain that points at the VPS (used by Caddy for TLS) and the public https URL.
DOMAIN=agent.example.com
PUBLIC_URL=https://agent.example.com
PORT=3000

# ---- Instagram (Instagram API with Instagram Login) ----
# Meta App Dashboard -> Instagram -> API setup with Instagram login.
IG_APP_ID=
IG_APP_SECRET=
# Optional: the Meta app secret. Set it only if webhooks are rejected with 401
# although IG_APP_SECRET is correct (see docs/api-validation.md, item 3).
META_APP_SECRET=
# Any random string; the same value goes into the webhook configuration in Meta.
WEBHOOK_VERIFY_TOKEN=
GRAPH_VERSION=v23.0

# ---- Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---- Telegram ----
# Token from @BotFather. Leave TELEGRAM_CHAT_ID empty on first run, send /start
# to the bot, copy the id it replies with, then restart.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- MCP ----
# Long random string (e.g. `openssl rand -hex 32`). The MCP URL is
# PUBLIC_URL/mcp/<MCP_SECRET> - treat the whole URL as a password.
MCP_SECRET=

# ---- Dashboard ----
# Read-only web dashboard at PUBLIC_URL/dash/<DASHBOARD_SECRET>/ . It shows DM
# text, so treat the URL as a password. Leave empty to disable the dashboard.
DASHBOARD_SECRET=

# ---- Behaviour ----
# Off by default: every reply waits for approval in Telegram.
AUTO_SEND_DM=false
AUTO_SEND_COMMENTS=false
# Max automatic replies per conversation per day (only when AUTO_SEND_DM=true).
AUTO_SEND_MAX_PER_THREAD=3
# Wait this long after the last incoming message before drafting.
DEBOUNCE_SECONDS=45
# Polling fallback for when webhooks do not arrive.
POLLING_ENABLED=true
POLL_INTERVAL_SECONDS=120
# Comments older than this are stored but not drafted.
COMMENT_MAX_AGE_HOURS=48
# Comment -> DM campaigns: max private replies per hour (overflow waits in a queue).
CAMPAIGN_MAX_PER_HOUR=100
# Hour (Israel time) of the daily Telegram summary. -1 turns it off.
DAILY_SUMMARY_HOUR=21
